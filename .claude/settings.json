{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"Hello! Welcome to the employee app. Run py -m pytest to check the tests, or py app.py to start the server.\"}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git push*)",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/db_script_check.py\""
          }
        ]
      },
      {
        "matcher": "mcp__github__push_files|mcp__github__create_or_update_file",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/db_script_check.py\""
          }
        ]
      }
    ]
  }
}
